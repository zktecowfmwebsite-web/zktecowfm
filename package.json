{
  "name": "zkteco-wfm-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "css:build": "tailwindcss -i ./src/styles/tailwind.css -o ./public/assets/tailwind.css --minify",
    "dev": "npm run css:build && astro dev",
    "build": "node scripts/sync-public.mjs && npm run css:build && node scripts/verify-tailwind-links.mjs && astro check && astro build",
    "preview": "astro preview",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "astro": "^5.2.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5"
  }
}
