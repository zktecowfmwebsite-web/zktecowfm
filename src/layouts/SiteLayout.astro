---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import '../../assets/site-enhancements.css';
import '../../assets/layout-standard-v114.css';
import '../../assets/privacy.css';

interface Props { title: string; description?: string }
const { title, description = 'ZKTecoWFM workforce data collection solutions.' } = Astro.props;
const canonicalPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={`https://zktecowfm.com${canonicalPath}`} />
    <title>{title}</title>
    <link href="/assets/tailwind.css" rel="stylesheet" />
    <Analytics />
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer includeAnalytics={false} includeSpeedInsights={false} />
    <script is:inline src="/assets/privacy.js"></script>
    <SpeedInsights />
  </body>
</html>
