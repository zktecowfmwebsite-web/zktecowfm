---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import '../../assets/site-enhancements.css';
import '../../assets/layout-standard-v114.css';
import '../../assets/privacy.css';

interface Props { title: string; description?: string }
const { title, description = 'ZKTecoWFM workforce data collection solutions.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <SeoHead description={description} />
    <title>{title}</title>
    <link href="/assets/tailwind.css" rel="stylesheet" />
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
    <script is:inline src="/assets/privacy.js"></script>
    <script src="/assets/legal-policy-sidebar.js" defer></script>
  </body>
</html>
