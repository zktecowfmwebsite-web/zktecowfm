---
const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path;
---

<header class="zk-global-header">
  <div class="zk-nav-shell">
    <a class="zk-brand" href="/" aria-label="ZKTeco WFM home">
      <img class="zk-brand-logo" src="/assets/zkteco-wfm-every-punch-matters.png" alt="ZKTeco WFM — Every Punch Matters" />
    </a>
    <nav class="zk-menu" aria-label="Primary navigation">
      <a href="/workday.html">Workday Solution</a>
      <a href="/software-partners.html">Software Partners</a>
      <a href="/ultima-series.html">Products</a>
      <a href="/why-zkteco-wfm.html">Why ZKTeco WFM</a>
      <a class:list={[{ active: isActive('/resources.html') }]} href="/resources.html">Resources</a>
      <a href="https://zktecowfm.com/events/">Events</a>
      <a href="/support.html">Support</a>
      <a class="zk-talk" href="/contact.html">Talk to an Expert</a>
    </nav>
  </div>
