      color: currentColor !important;
      opacity: .72;
      transform: translateY(-1px) !important;
      transition: transform .24s cubic-bezier(.22,1,.36,1), color .2s ease !important;
    }
    html body .zk-global-header .zk-nav-chevron::before { content: none !important; }
    html body .zk-global-header .zk-nav-chevron svg {
      display: block !important;
      width: 13px !important;
      height: 9px !important;
      fill: none !important;
      stroke: currentColor !important;
      stroke-linecap: round !important;
      stroke-linejoin: round !important;
