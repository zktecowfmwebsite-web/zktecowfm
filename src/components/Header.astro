<script is:inline>
  const favicon = document.querySelector('link[rel="icon"]') || document.createElement('link');
  favicon.rel = 'icon';
  favicon.type = 'image/svg+xml';
  favicon.href = '/assets/zkteco-wfm-favicon.svg?v=7';
  document.head.appendChild(favicon);
</script>

<header class="zk-global-header">
  <div class="zk-nav-shell">
    <a class="zk-brand" href="/" aria-label="ZKTeco WFM home">
      <img class="zk-brand-logo" src="/assets/zkteco-wfm-every-punch-matters.png" alt="ZKTeco WFM — Every Punch Matters" />
    </a>
    <nav class="zk-menu" aria-label="Primary navigation">
      <a href="/workday">Workday Solution</a>
      <a href="/software-partners">Software Partners</a>
      <div class="zk-drop"><a data-nav-trigger="products" href="/ultima-series">Products<span class="zk-nav-chevron" aria-hidden="true"><svg viewBox="0 0 16 10"><path d="m1 1 7 7 7-7" /></svg></span></a><div class="zk-drop-menu"><a href="/ultima-series">Ultima Series</a><a href="/timetrack">TimeTrack</a><a href="/cirrusconnect">CirrusConnect</a></div></div>
      <a href="/why-zkteco-wfm">Why ZKTeco WFM</a>
      <div class="zk-drop">
        <a data-nav-trigger="resources" href="/resource-hub">Resource Hub<span class="zk-nav-chevron" aria-hidden="true"><svg viewBox="0 0 16 10"><path d="m1 1 7 7 7-7" /></svg></span></a>
        <div class="zk-drop-menu"><a href="/product-collaterals">Product Collaterals</a><a href="/thought-leadership">Thought Leadership</a><a href="/legal-privacy">Legal &amp; Privacy</a></div>
      </div>
      <a href="/events">Events</a>
      <a href="/support">Support</a>
      <a class="zk-talk" href="/contact">Talk to an Expert</a>
    </nav>
  </div>
</header>

<style is:global>
  @media (min-width: 761px) {
    html body .zk-global-header a[data-nav-trigger]::after {
      content: "" !important;
      display: inline-block !important;
      box-sizing: border-box !important;
      width: 9px !important;
      height: 9px !important;
      margin: -4px 0 0 9px !important;
      border-right: 2px solid currentColor !important;
      border-bottom: 2px solid currentColor !important;
      transform: rotate(45deg) !important;
      transition: transform .24s cubic-bezier(.22,1,.36,1), color .2s ease !important;
    }
    html body .zk-global-header .zk-nav-chevron {
      display: none !important;
      align-items: center !important;
      justify-content: center !important;
      margin: 0 0 0 7px !important;
      border: 0 !important;
      color: currentColor !important;
      opacity: .72;
      transform: translateY(-1px) !important;
      transition: transform .24s cubic-bezier(.22,1,.36,1), color .2s ease !important;
    }
    html body .zk-global-header .zk-nav-chevron::before { content: none !important; }
    html body .zk-global-header .zk-nav-chevron svg {
      display: block !important;
      width: 13px !important;
      height: 9px !important;
      fill: none !important;
      stroke: currentColor !important;
      stroke-linecap: round !important;
      stroke-linejoin: round !important;
      stroke-width: 2 !important;
    }
    html body .zk-global-header .zk-drop:hover a[data-nav-trigger]::after,
    html body .zk-global-header .zk-drop:focus-within a[data-nav-trigger]::after {
      transform: rotate(225deg) translateY(-1px) !important;
    }
  }
</style>
