</div></section><section class="migration-motion-section"><div class="wrap"><div class="section-head"><div class="eyebrow">SPECIAL WORKDAY PROGRAMS</div><h2>Make the Switch<br/>Get More</h2><p>Whether you’re moving to Workday or already live on Workday, our exclusive programs make it easier to upgrade your time clock technology.</p></div><div class="program-grid"><article class="program-card"><div class="program-tag">MOVING TO WORKDAY?</div><h3>Trade In. Move Forward.</h3><p>Replace your legacy time clocks as part of your move to Workday with exclusive trade-in incentives on the Ultima Series.</p><a class="program-link" href="contact">I’M INTERESTED IN THE TRADE-IN PROGRAM <span>→</span></a></article><article class="program-card"><div class="program-tag">ALREADY ON WORKDAY?</div><h3>Ready for a Better Time Clock?</h3><p>Replace your current time clock solution with the Ultima Series and take advantage of our exclusive competitive replacement program.</p><a class="program-link" href="contact">I’M INTERESTED IN THE SWITCH PROGRAM <span>→</span></a></article></div></div></section><section><div class="wrap"><div class="section-head"><div class="eyebrow">WORKDAY VALUE PROPOSITION</div><h2>Certified. Managed. Protected.</h2><p>Three Workday-specific advantages that simplify integration, centralize management and protect the collection environment over time.</p></div><div class="cmp-grid tw-grid tw-grid-cols-3 tw-gap-[16px] max-[1000px]:tw-grid-cols-1"><article class="cmp-card"><div class="cmp-head">CERTIFIED</div><div class="cmp-body"><strong>Workday-certified integration for confident data exchange.</strong><p>Designed to exchange employee time and labor data between the ZKTeco WFM collection environment and Workday.</p><ul><li>Workday-certified integration</li><li>Proven Workday deployments</li><li>Purpose-built collection architecture</li></ul></div></article><article class="cmp-card"><div class="cmp-head">MANAGED</div><div class="cmp-body"><strong>Centrally managed through CirrusDCS.</strong><p>Centralize connectivity, device management, monitoring, configuration and data exchange through the Workday-specific cloud layer.</p><ul><li>Centralized device visibility</li><li>Configuration and monitoring</li><li>Controlled data exchange</li></ul></div></article><article class="cmp-card"><div class="cmp-head">PROTECTED</div><div class="cmp-body"><strong>Protected for long-term deployment.</strong><p>Enterprise security controls, ongoing support and lifetime hardware warranty* help protect the collection environment over the long term.</p><ul><li>Enterprise security controls</li><li>Ongoing support</li><li>Lifetime hardware warranty*</li></ul></div></article></div><div class="warranty warranty-no-cta compact-warranty"><div class="warranty-badge">LIFETIME<br/>HARDWARE<br/>WARRANTY</div><div><h3>Lifetime Hardware Warranty for Workday Customers</h3><small>*Conditions apply.</small></div></div></div></section><section class="mist manufacturing-control-section"><div class="wrap mfg-compact"><div class="mfg-compact-copy"><div class="eyebrow">END-TO-END MANUFACTURING CONTROL</div><h2>More Control from Design Through Production</h2><p>From engineering and tooling to production and quality assurance, ZKTeco controls the entire manufacturing process, delivering greater reliability, faster innovation, and long-term product continuity.</p></div><aside aria-label="Atlanta Georgia U.S. manufacturing" class="atlanta-proof"><div aria-hidden="true" class="atlanta-flag"><img src="assets/united-states-flag-icon.svg" alt="" /></div><div class="atlanta-tag">U.S.A. MANUFACTURING</div><h3>Atlanta, Georgia</h3><p>Manufacturing facility now ready for Ultima production.</p></aside></div><div class="wrap"><a class="mfg-gallery-strip" href="manufacturing-facilities"><span><strong>Manufacturing Facilities</strong><small>Explore our manufacturing facilities, production lines and hardware capabilities.</small></span><b>Explore Facilities →</b></a></div></section><section><div class="wrap"><div class="section-head"><div class="eyebrow">GLOBAL CAPABILITIES</div><h2>Global Expertise Behind Every Deployment</h2><p>Specialized product, software, implementation and support teams help customers deploy and operate with confidence.</p></div><div class="capability-grid"><article class="capability-card"><div class="cap-label">Hardware</div><h3>Global R&amp;D &amp; Engineering</h3><p>Hardware, electronics, embedded systems, mechanical and product engineering resources support ongoing innovation and future product generations.</p></article><article class="capability-card"><div class="cap-label">Software</div><h3>Software &amp; Cloud Development</h3><p>Dedicated development resources support device software, cloud services, workforce applications and the integration technology behind ZKTeco WFM solutions.</p></article><article class="capability-card"><div class="cap-label">Customer Operations</div><h3>Global Support &amp; Operations</h3><p>Distributed support and operational resources help customers manage deployments across locations, time zones and workforce environments.</p></article></div></div></section><section class="cta-section"><div class="wrap"><div class="eyebrow">EVERY PUNCH MATTERS</div><h2>Make Workforce Data Collection Easier for Workday</h2><p>Talk with our team about your workforce, locations, employee workflows, current devices and Workday timeline.</p><div class="hero-actions" style="justify-content:center;margin-top:24px"><a class="btn primary" href="contact">Request a Free Clock Demo</a><a class="btn secondary" href="ultima-series">Explore Ultima Series</a></div></div></section></main><footer class="zk-global-footer"><div class="zk-footer-shell"><div class="zk-footer-grid"><div class="zk-footer-brand"><strong>ZKTeco WFM</strong><p>The Workforce Data Collection Company.<br/>Every Punch Matters.</p></div><div class="zk-footer-col"><h4>Solutions</h4><a href="workday">Workday Customers</a><a href="software-partners">Software Partners</a><a href="use-cases">Industry Use Cases</a><a href="customer-stories">Customer Stories</a></div><div class="zk-footer-col"><h4>Products</h4><a href="ultima-series">Ultima Series</a><a href="timetrack">TimeTrack</a><a href="cirrusconnect">CirrusConnect</a><a href="workday#cirrusdcs">CirrusDCS</a></div><div class="zk-footer-col"><h4>Resources &amp; Trust</h4><a href="resources">Resource Hub</a><a href="thought-leadership">Thought Leadership</a><a href="security-trust">Security &amp; Trust</a><span aria-disabled="true" class="zk-link-disabled">Trust Center — Coming Soon</span><a href="support">Support</a></div><div class="zk-footer-col"><h4>Company</h4><a href="why-zkteco-wfm">Why ZKTeco WFM</a><a href="contact">Contact</a><a href="https://zktecowfm.com/careers/">Careers</a><a href="https://zktecowfm.com/events/">Events</a><a href="https://zktecowfm.com/biometric-privacy-policy/">Biometric Privacy</a></div></div><div class="zk-footer-bottom"><span>© 2026 ZKTeco WFM. All rights reserved.</span><div class="zk-footer-legal"><a href="privacy">Privacy &amp; GDPR</a><a href="cookie-policy">Cookies</a><button data-cookie-settings="">Cookie Preferences</button><a href="terms">Terms</a><a href="accessibility">Accessibility</a><a href="educational-disclaimer">Educational Disclaimer</a></div></div></div></footer><script is:inline>
  const migrationSection = document.querySelector('.migration-motion-section');
  if (migrationSection && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const migrationCards = [...migrationSection.querySelectorAll('.program-card')];
    const cardMotions = new Map();
    const focusedTarget = { transform: 'scale(1.07)', shadow: '0 0 22px rgba(117,189,59,.28)' };
    const restingTarget = { transform: 'scale(1)', shadow: '0 0 0 rgba(117,189,59,0)' };
    let animationRun = 0;
    let sectionIsVisible = false;
    const wait = (milliseconds) => new Promise((resolve) => window.setTimeout(resolve, milliseconds));
    const moveCard = (card, target, focused) => {
      const currentStyle = getComputedStyle(card);
      cardMotions.get(card)?.cancel();
      card.classList.toggle('is-card-focused', focused);
      const motion = card.animate([
        { transform: currentStyle.transform, boxShadow: currentStyle.boxShadow },
        { transform: target.transform, boxShadow: target.shadow }
      ], { duration: 250, easing: 'linear', fill: 'forwards' });
      cardMotions.set(card, motion);
      return motion.finished.then(() => {
        if (cardMotions.get(card) !== motion) return;
        card.style.transform = target.transform;
        card.style.boxShadow = target.shadow;
      }).catch(() => {});
    };
    const stopAnimation = (cancelMotions = false) => {
      animationRun += 1;
      if (cancelMotions) cardMotions.forEach((motion) => motion.cancel());
    };
    const runCardLoop = async (focusedCard, alreadyFocused = false) => {
      const run = ++animationRun;
      const otherCard = migrationCards.find((card) => card !== focusedCard);
      if (!alreadyFocused) await Promise.all([moveCard(focusedCard, focusedTarget, true), moveCard(otherCard, restingTarget, false)]);
      let activeCard = focusedCard;
      while (sectionIsVisible && run === animationRun) {
        await wait(3000);
        if (!sectionIsVisible || run !== animationRun) return;
        const nextCard = migrationCards.find((card) => card !== activeCard);
        await Promise.all([moveCard(activeCard, restingTarget, false), moveCard(nextCard, focusedTarget, true)]);
        activeCard = nextCard;
      }
    };
    const startAnimation = (focusedCard, alreadyFocused = false) => { if (sectionIsVisible) runCardLoop(focusedCard, alreadyFocused); };
    migrationCards.forEach((card) => {
      card.addEventListener('mouseenter', () => {
        stopAnimation();
        moveCard(card, focusedTarget, true);
        moveCard(migrationCards.find((candidate) => candidate !== card), restingTarget, false);
      });
      card.addEventListener('mouseleave', (event) => {
        const nextCard = event.relatedTarget?.closest('.program-card');
        if (!nextCard || !migrationSection.contains(nextCard)) startAnimation(card, true);
      });
    });
    new IntersectionObserver(([entry]) => {
      sectionIsVisible = entry.isIntersecting;
      if (sectionIsVisible) startAnimation(migrationCards[0]);
      else {
        stopAnimation(true);
        migrationCards.forEach((card) => { card.style.transform = ''; card.style.boxShadow = ''; card.classList.remove('is-card-focused'); });
      }
    }, { threshold: 0.25 }).observe(migrationSection);
  }
</script><script is:inline src="assets/privacy.js"></script></body></html>
