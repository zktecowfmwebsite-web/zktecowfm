:root{--ev-navy:#201f62;--ev-deep:#11153e;--ev-green:#75bd3b;--ev-ink:#171a42;--ev-muted:#687086;--ev-line:#dfe4ec;--ev-soft:#f6f8fb}
*{box-sizing:border-box}.ev-wrap{width:min(1180px,calc(100% - 48px));margin:auto}.ev-hero{padding:82px 0 76px;background:linear-gradient(135deg,#fff 0%,#fff 55%,#f2f6fa 100%);position:relative;overflow:hidden}.ev-hero:after{content:"";position:absolute;width:420px;height:420px;border-radius:50%;right:-150px;top:-180px;background:radial-gradient(circle,rgba(117,189,59,.16),transparent 68%)}.ev-hero-copy{position:relative;z-index:1;max-width:850px}.ev-eyebrow{font-size:11px;font-weight:900;letter-spacing:.15em;text-transform:uppercase;color:var(--ev-green);margin-bottom:13px}.ev-hero h1{font-size:clamp(44px,5vw,62px);line-height:1.02;letter-spacing:-.045em;color:var(--ev-navy);margin:0 0 19px}.ev-hero p{font-size:18px;line-height:1.65;color:var(--ev-muted);max-width:760px;margin:0 0 28px}.ev-btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;border-radius:8px;padding:13px 17px;font-size:13px;font-weight:850;text-decoration:none;transition:.2s}.ev-btn.primary{background:var(--ev-green);color:#132043}.ev-btn.dark{background:var(--ev-navy);color:#fff}.ev-btn.outline{border:1px solid #ccd3df;color:var(--ev-navy);background:#fff}.ev-btn:hover{transform:translateY(-1px)}.ev-events{padding:78px 0 86px;background:linear-gradient(180deg,#fff 0%,#f8fafc 100%)}.ev-head{max-width:760px;margin-bottom:35px}.ev-head h2{font-size:clamp(34px,4vw,46px);line-height:1.05;letter-spacing:-.035em;color:var(--ev-navy);margin:0 0 12px}.ev-head p{font-size:16px;line-height:1.65;color:var(--ev-muted);margin:0}.ev-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;align-items:stretch}.ev-card{border:1px solid var(--ev-line);border-radius:18px;background:#fff;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 13px 34px rgba(24,29,74,.065);transition:.22s}.ev-card:hover{transform:translateY(-4px);box-shadow:0 20px 44px rgba(24,29,74,.11)}.ev-card-media{height:205px;overflow:hidden;background:#eef2f7}.ev-card-media img{width:100%;height:100%;object-fit:cover;display:block}.ev-card-top{height:9px;background:var(--ev-navy)}.ev-card.hr .ev-card-top{background:var(--ev-green)}.ev-card-body{padding:26px 25px 23px;display:flex;flex-direction:column;flex:1}.ev-type{font-size:10px;font-weight:900;letter-spacing:.13em;text-transform:uppercase;color:var(--ev-green);margin-bottom:10px}.ev-card h3{font-size:26px;line-height:1.08;letter-spacing:-.025em;color:var(--ev-navy);margin:0 0 10px}.ev-meta{font-size:13px;font-weight:800;color:#4f5870;padding-bottom:16px;border-bottom:1px solid #e8ebf0;margin-bottom:17px}.ev-position{font-size:17px;line-height:1.35;font-weight:850;color:var(--ev-ink);margin-bottom:10px}.ev-card p{font-size:14px;line-height:1.6;color:var(--ev-muted);margin:0 0 20px}.ev-actions{margin-top:auto;display:grid;grid-template-columns:1fr 1fr;gap:8px}.ev-actions .meet{grid-column:1/-1}.ev-actions .ev-btn{padding:12px 10px}.ev-experience{padding:78px 0;background:linear-gradient(135deg,#f1f4f8 0%,#f8fafc 52%,#eef5e9 100%);border-top:1px solid #e1e6ed;border-bottom:1px solid #e1e6ed}.ev-exp-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.ev-exp{background:#fff;border:1px solid var(--ev-line);border-radius:14px;padding:22px;text-decoration:none;display:flex;flex-direction:column;min-height:154px;box-shadow:0 8px 22px rgba(24,29,74,.045);transition:.22s;position:relative}.ev-exp:hover{transform:translateY(-3px);border-color:#b9c5d3;box-shadow:0 15px 32px rgba(24,29,74,.10)}.ev-exp:focus-visible{outline:3px solid rgba(117,189,59,.45);outline-offset:3px}.ev-exp strong{display:block;font-size:17px;color:var(--ev-navy);margin-bottom:7px}.ev-exp span{font-size:13px;line-height:1.55;color:var(--ev-muted)}.ev-exp-link{margin-top:auto;padding-top:15px;font-size:11px;font-weight:900;letter-spacing:.08em;text-transform:uppercase;color:#5f9f2f}.ev-exp:hover .ev-exp-link{color:var(--ev-navy)}.ev-markets{padding:78px 0;background:#fff}.ev-market-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.ev-market{border-radius:18px;padding:32px;background:var(--ev-navy);color:#fff}.ev-market.partner{background:#eef6e8;color:var(--ev-navy);border:1px solid #d5e6c6}.ev-market .ev-type{color:#a9db72}.ev-market.partner .ev-type{color:#5f9f2f}.ev-market h3{font-size:29px;line-height:1.1;letter-spacing:-.025em;margin:0 0 11px}.ev-market p{font-size:14px;line-height:1.6;color:#cbd2e1;margin:0 0 20px}.ev-market.partner p{color:#667089}.ev-final{padding:68px 0;background:linear-gradient(115deg,#171c55,#242a70);color:#fff}.ev-final-inner{display:flex;align-items:center;justify-content:space-between;gap:36px}.ev-final h2{font-size:38px;line-height:1.05;letter-spacing:-.035em;margin:0 0 11px}.ev-final p{font-size:16px;line-height:1.55;color:#cbd2e1;margin:0;max-width:650px}
@media(max-width:900px){.ev-card-media{height:260px}.ev-grid,.ev-exp-grid{grid-template-columns:1fr}.ev-market-grid{grid-template-columns:1fr}.ev-final-inner{align-items:flex-start;flex-direction:column}}@media(max-width:600px){.ev-wrap{width:min(100% - 30px,1180px)}.ev-hero{padding:58px 0}.ev-events,.ev-experience,.ev-markets{padding:58px 0}.ev-card-body{padding:22px 20px}.ev-actions{grid-template-columns:1fr}.ev-actions .meet{grid-column:auto}.ev-final{padding:55px 0}.ev-final h2{font-size:32px}}
.ev-events-first{padding-top:54px}.ev-head-intro{display:grid;justify-items:center;max-width:none;margin-bottom:30px;text-align:center}.ev-head-intro h1{font-size:clamp(38px,4.4vw,54px);line-height:1.04;letter-spacing:-.04em;color:var(--ev-navy);margin:0 0 13px;white-space:nowrap;text-align:center}.ev-head-intro p{font-size:17px;max-width:800px;margin-left:auto;margin-right:auto;text-align:center}.ev-grid{grid-template-columns:repeat(3,1fr)}@media(max-width:900px){.ev-grid{grid-template-columns:1fr}.ev-head-intro h1{white-space:normal}}
.ev-final .ev-btn.primary>span{display:inline-flex;line-height:1;transition:transform .6s cubic-bezier(.22,1,.36,1)}.ev-final .ev-btn.primary:hover>span{transform:translate3d(6px,0,0)}
/* Home page solution-card CTA treatment for the Events market cards. */
.ev-market .ev-btn{display:inline-flex;align-items:center;justify-content:space-between;gap:24px;min-width:0;padding:13px 20px;border:1px solid transparent;border-radius:14px;font-size:16px;font-weight:700;line-height:1.2;letter-spacing:normal;will-change:transform;transition:transform .6s cubic-bezier(.22,1,.36,1),box-shadow .6s cubic-bezier(.22,1,.36,1),filter .6s cubic-bezier(.22,1,.36,1)}
.ev-market .ev-btn.primary{background:radial-gradient(ellipse 78% 130% at 8% 8%,rgba(196,239,137,.42),transparent 62%),linear-gradient(115deg,#84c94b 0%,#78bd43 54%,#70b73e 100%);border-color:#a8e274;color:#102044;box-shadow:inset 0 1px 0 rgba(237,255,216,.4),0 14px 30px rgba(0,0,0,.18)}
.ev-market .ev-btn.dark{background:radial-gradient(ellipse 80% 145% at 8% 6%,rgba(116,132,232,.24),transparent 62%),radial-gradient(ellipse 68% 120% at 94% 95%,rgba(33,31,110,.2),transparent 72%),linear-gradient(115deg,#3a4398 0%,#2b2a79 54%,#24236b 100%);border-color:rgba(113,126,220,.78);color:#fff;box-shadow:inset 0 1px 0 rgba(225,230,255,.16),0 14px 30px rgba(20,23,83,.2)}
.ev-market .ev-btn>span{display:inline-flex;transition:transform .6s cubic-bezier(.22,1,.36,1)}.ev-market .ev-btn:hover{transform:translateY(-3px);filter:brightness(1.075)}.ev-market .ev-btn.primary:hover{box-shadow:inset 0 1px 0 rgba(237,255,216,.5),0 16px 28px rgba(68,139,35,.25)}.ev-market .ev-btn.dark:hover{box-shadow:inset 0 1px 0 rgba(225,230,255,.48),0 16px 28px rgba(20,23,83,.28)}.ev-market .ev-btn:hover>span{transform:translate3d(6px,0,0)}
@media(prefers-reduced-motion:reduce){.ev-market .ev-btn,.ev-market .ev-btn>span{transition:none}.ev-market .ev-btn:hover,.ev-market .ev-btn:hover>span{transform:none}}
@media(min-width:901px){.ev-experience .ev-head,.ev-markets .ev-head{width:calc(100vw - 96px);max-width:none;margin-left:50%;transform:translateX(-50%);text-align:center}.ev-experience .ev-head h2,.ev-markets .ev-head h2{white-space:nowrap}}
@media(min-width:901px){.ev-experience .ev-head{width:min(1200px,calc(100vw - 96px));max-width:1200px;margin:0 auto 35px;transform:none;text-align:center}.ev-experience .ev-head h2{max-width:1200px;margin-left:auto;margin-right:auto;white-space:normal;text-align:center}}
/* Event cards remain still; only their calls to action receive hover feedback. */
.ev-card:hover{transform:none;box-shadow:0 13px 34px rgba(24,29,74,.065)}.ev-actions .ev-btn{font-size:0;transition:transform .6s cubic-bezier(.22,1,.36,1),box-shadow .6s cubic-bezier(.22,1,.36,1),filter .6s cubic-bezier(.22,1,.36,1)}.ev-actions .ev-btn.primary{border:1px solid #a8e274;background:radial-gradient(ellipse 78% 130% at 8% 8%,rgba(196,239,137,.42),transparent 62%),linear-gradient(115deg,#84c94b 0%,#78bd43 54%,#70b73e 100%);box-shadow:inset 0 1px 0 rgba(237,255,216,.4),0 14px 30px rgba(0,0,0,.18)}.ev-actions .ev-btn.dark{border:1px solid rgba(113,126,220,.78);background:radial-gradient(ellipse 80% 145% at 8% 6%,rgba(116,132,232,.24),transparent 62%),radial-gradient(ellipse 68% 120% at 94% 95%,rgba(33,31,110,.2),transparent 72%),linear-gradient(115deg,#3a4398 0%,#2b2a79 54%,#24236b 100%);box-shadow:inset 0 1px 0 rgba(225,230,255,.16),0 14px 30px rgba(20,23,83,.2)}.ev-actions .ev-btn::before,.ev-actions .ev-btn::after{font-size:13px;font-weight:850;line-height:1}.ev-actions .meet::before{content:"Meet ZKTeco WFM"}.ev-actions .outline::before{content:"Event Website"}.ev-actions .dark::before{content:"Register"}.ev-actions .dark[href*="register-interest"]::before{content:"Register Interest"}.ev-actions .ev-btn::after{content:"→";display:inline-block;will-change:transform;transition:transform .45s cubic-bezier(.22,1,.36,1)}.ev-actions .ev-btn:hover{transform:translateY(-3px);filter:brightness(1.075)}.ev-actions .ev-btn.primary:hover{box-shadow:inset 0 1px 0 rgba(237,255,216,.5),0 16px 28px rgba(68,139,35,.25)}.ev-actions .ev-btn.dark:hover{box-shadow:inset 0 1px 0 rgba(225,230,255,.48),0 16px 28px rgba(20,23,83,.28)}.ev-actions .ev-btn:hover::after{transform:translate3d(5px,0,0)!important}
.ev-actions .ev-btn:hover{filter:brightness(1.03)!important}
.ev-actions .ev-btn.primary,.ev-actions .ev-btn.dark,.ev-actions .ev-btn.primary:hover,.ev-actions .ev-btn.dark:hover{box-shadow:none!important}
.ev-actions .dark[href*="register-interest"]::before{content:"Register"}
@media(min-width:901px){html body .ev-experience .ev-head h2{width:min(1150px,calc(100vw - 96px))!important;max-width:100%!important;margin-left:auto!important;margin-right:auto!important;white-space:normal!important;text-align:center!important}}
@media(min-width:901px){html body .ev-experience .ev-head h2{font-size:0!important;line-height:1.05!important}html body .ev-experience .ev-head h2::after{content:"Don’t Just See a Time Clock, See the\A Ecosystem Behind It";display:inline-block;font-size:clamp(34px,4vw,46px);line-height:1.05;letter-spacing:-.035em;white-space:pre-line}}
