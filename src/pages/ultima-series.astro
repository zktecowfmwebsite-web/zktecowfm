<script is:inline>
  document.querySelectorAll('.ultima-carousel:not(#ultima5):not(#ultima7):not(#ultima10)').forEach((carousel) => {
    const images = [...carousel.querySelectorAll('.ultima-carousel-viewport img')];
    const previous = carousel.querySelector('.is-prev');
    const next = carousel.querySelector('.is-next');
    let current = 0;
    const show = (index) => {
      current = (index + images.length) % images.length;
      images.forEach((image, imageIndex) => image.classList.toggle('is-active', imageIndex === current));
    };
    previous.addEventListener('click', () => show(current - 1));
    next.addEventListener('click', () => show(current + 1));
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      window.setInterval(() => show(current + 1), 2000);
    }
  });
</script><script is:inline>
  const comparisonTable = document.querySelector('#compare table');
  if (comparisonTable) {
    const productColumnOrder = [4, 2, 3, 1]; // Ultima 10, 7, 7P, 5
    comparisonTable.querySelectorAll('tr').forEach((row) => {
      const cells = [...row.children];
      row.replaceChildren(cells[0], ...productColumnOrder.map((index) => cells[index]));
    });
  }
</script><script is:inline>
