<script is:inline>
  const solutionsSection = document.querySelector('.segments-section');
  if (solutionsSection) {
    const solutionCards = solutionsSection.querySelectorAll('.segment-card');
    const toggleSolutionCardAnimation = ([entry]) => {
      solutionsSection.classList.toggle('is-card-animation-active', entry.isIntersecting);
    };
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(toggleSolutionCardAnimation, { threshold: 0.25 }).observe(solutionsSection);
    } else {
      solutionsSection.classList.add('is-card-animation-active');
    }
    solutionCards.forEach((card) => {
      const cardLink = card.querySelector('.segment-link');
      if (!cardLink) return;
      card.tabIndex = 0;
      card.setAttribute('role', 'link');
      card.setAttribute('aria-label', cardLink.textContent.trim());
      card.addEventListener('click', (event) => {
        if (event.target.closest('a, button')) return;
        window.location.href = cardLink.href;
      });
      card.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        cardLink.click();
      });
    });
    solutionCards.forEach((card) => {
      const otherCard = [...solutionCards].find((candidate) => candidate !== card);
      card.addEventListener('mouseenter', () => {
        card.classList.remove('is-card-hover-muted');
        card.classList.add('is-card-hover-focus');
        otherCard?.classList.remove('is-card-hover-focus');
        otherCard?.classList.add('is-card-hover-muted');
      });
      card.addEventListener('mouseleave', (event) => {
        const nextCard = event.relatedTarget?.closest('.segment-card');
        if (nextCard && solutionsSection.contains(nextCard)) return;
        card.classList.remove('is-card-hover-focus');
        otherCard?.classList.remove('is-card-hover-muted');
      });
    });
  }
</script>
<script is:inline>
  const zohoModal = document.querySelector('[data-zoho-modal]');
  let zohoLastTrigger;
  const closeZohoLeadForm = () => {
    zohoModal?.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('zoho-modal-open');
    zohoLastTrigger?.focus();
  };
  const openZohoLeadForm = (trigger) => {
    zohoLastTrigger = trigger || document.activeElement;
    zohoModal?.setAttribute('aria-hidden', 'false');
    document.body.classList.add('zoho-modal-open');
    zohoModal?.querySelector('#Company')?.focus();
  };
  document.querySelectorAll('.final-cta-button, [data-zoho-form-open]').forEach((trigger) => trigger.addEventListener('click', (event) => {
    event.preventDefault();
    openZohoLeadForm(trigger);
  }));
  zohoModal?.querySelectorAll('[data-zoho-form-close]').forEach((button) => button.addEventListener('click', closeZohoLeadForm));
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && zohoModal?.getAttribute('aria-hidden') === 'false') closeZohoLeadForm(); });
  zohoModal?.querySelector('[data-zoho-captcha-reload]')?.addEventListener('click', () => {
    const captcha = document.getElementById('imgid4421205000000933108');
    captcha.src = captcha.src.replace(/&d\d+$/, '') + '&d' + Date.now();
  });
  zohoModal?.querySelector('form')?.addEventListener('submit', (event) => {
    const form = event.currentTarget;
    if (!form.checkValidity()) { event.preventDefault(); form.reportValidity(); return; }
    form.querySelector('.formsubmit')?.setAttribute('disabled', 'disabled');
  });
  if (new URLSearchParams(window.location.search).has('openZohoForm')) openZohoLeadForm();
</script>
