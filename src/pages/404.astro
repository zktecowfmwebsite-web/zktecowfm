---

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/pages/home-zoho.css';
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Page Not Found | ZKTeco WFM</title><link rel="stylesheet" href="/assets/tailwind.css" /><link rel="stylesheet" href="/assets/layout-standard-v114.css" /><link rel="canonical" href="https://zktecowfm.com/404" /></head>
  <body class="zk-page">
    <Header />
    <main style="min-height:62vh;display:grid;place-items:center;padding:64px 24px;text-align:center;background:#f7f9fc"><section><p style="font-weight:800;letter-spacing:.12em;color:#78bd43">ERROR 404</p><h1 style="margin:0;color:#201f62;font-size:clamp(38px,6vw,72px)">This page can’t be found.</h1><p style="color:#62677e;font-size:18px;max-width:540px;margin:18px auto 30px">The link may be outdated or the page may have moved.</p><a href="/" style="display:inline-block;padding:13px 20px;border-radius:10px;background:#78bd43;color:#102044;font-weight:800;text-decoration:none">Return home</a></section></main>
    <Footer />
  </body>
</html>
