---
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/pages/manufacturing-facilities.css';
---

<SiteLayout
  title="Manufacturing Facilities | ZKTeco WFM"
  description="Explore ZKTeco WFM manufacturing, engineering, tooling, electronics production, assembly and quality capabilities."
>
  <section class="hero">
    <div class="wrap">
      <div class="eyebrow">MANUFACTURING FACILITIES</div>
      <h1>See Where the Hardware Comes From</h1>
      <p>Explore the engineering, production and manufacturing capabilities behind ZKTeco WFM hardware.</p>
    </div>
  </section>

  <section class="gallery">
    <div class="wrap">
      <div class="gallery-head">
        <div>
          <h2>Facilities &amp; Production</h2>
          <p>Inside the facilities where Ultima Series devices are designed, assembled and tested.</p>
        </div>
      </div>
      <div class="grid">
        <div class="tile atlanta">
          <img src="/assets/🇺🇸 Atlanta, Georgia.jpg" alt="ZKTeco WFM Atlanta, Georgia production facility" />
          <div><strong>Atlanta, Georgia</strong><span>Ultima production facility</span></div>
        </div>
        <div class="tile">
          <img src="/assets/Engineering &amp; Tooling.jpg" alt="Engineering and tooling facility" />
          <div><strong>Engineering &amp; Tooling</strong><span>Product, mechanical, mold and tooling</span></div>
        </div>
        <div class="tile">
          <img src="/assets/Injection Molding.jpg" alt="Injection molding production" />
          <div><strong>Injection Molding</strong><span>Enclosure and component production</span></div>
        </div>
        <div class="tile">
          <img src="/assets/SMT &amp; Electronics.jpg" alt="SMT and electronics production line" />
          <div><strong>SMT &amp; Electronics</strong><span>Electronics production lines</span></div>
        </div>
        <div class="tile">
          <img src="/assets/Assembly.jpg" alt="Device assembly production" />
          <div><strong>Assembly</strong><span>Device assembly and production</span></div>
        </div>
        <div class="tile">
          <img src="/assets/Testing &amp; Quality.jpg" alt="Testing and quality control facility" />
          <div><strong>Testing &amp; Quality</strong><span>Testing, inspection and quality control</span></div>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
